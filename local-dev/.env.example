# Copy to .env next to docker-compose.yml. Never commit .env.
#
# GitHub PAT with Contents: Read on MartianBerk/baked-auth-client
# (required for docker compose build of auth / user / superiorsix).
BAKED_AUTH_CLIENT_GIT_TOKEN=

# Shared HS256 secret — must match across auth, user, and superiorsix.
JWT_SECRET=insecure-development-secret-change-me
JWT_ALGORITHM=HS256
JWT_KEY_ID=
# Quote JSON-looking values — Compose mangles unquoted [...] into a list.
JWT_PREVIOUS_SECRET_KEYS='[]'

# JWT aud for Superior Six resource servers (login with audience=superiorsix).
USER_JWT_AUDIENCE=superiorsix
SUPERIORSIX_JWT_AUDIENCE=superiorsix

# Bootstrap super user (auth-audience admin). Used by:
#   docker compose exec baked-auth baked-auth-bootstrap
# Also reused by baked-superiorsix inviteplayer for passwordless POST /v1/users
# + membership (aud=auth). Acceptinvite does not use these. Override with
# SUPERIORSIX_AUTH_ADMIN_* if needed.
AUTH_BOOTSTRAP_EMAIL=ops@example.com
# Must meet baked-auth legacy complexity (≥8, lower+upper+digit).
AUTH_BOOTSTRAP_PASSWORD=LocalDevChangeMe1
# SUPERIORSIX_AUTH_ADMIN_EMAIL=ops@example.com
# SUPERIORSIX_AUTH_ADMIN_PASSWORD=LocalDevChangeMe1
# Optional access JWT TTL (minutes); default ~31 days to match baked-auth.
# AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=44640

# CORS for Expo web (host) + optional app container (:8040).
# Must be a single quoted JSON string (unquoted [...] crashes auth).
CORS_ORIGINS='["http://localhost:8081","http://127.0.0.1:8081","http://localhost:19006","http://127.0.0.1:19006","http://localhost:8040","http://127.0.0.1:8040","http://localhost:3000"]'

# Optional ingest keys (match extractors / auto-score).
FOOTBALL_DATA_API_TOKEN=
GOAL_API_KEY=
