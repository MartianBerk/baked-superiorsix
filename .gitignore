# Repo root: only bootstrap files + src/ and tests/ (add !/path/ here when adding CI, etc.)
/*
!/.github/
!/.github/**
!/src/
!/src/**
!/tests/
!/tests/**

!/.gitignore
!/.env.example
!/.python-version
!/README.md
!/pyproject.toml
!/poetry.lock
!/poetry.toml
!/Dockerfile
!/docker-compose.yml
!/.dockerignore

# Read-only legacy reference (MartianBerk/supersix) for migration; not part of this repo.
reference/supersix/

# Python bytecode and packaging
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Local env and secrets
.venv/
venv/
.env

# Local runtime data
*.db

# Test and tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS
.DS_Store
