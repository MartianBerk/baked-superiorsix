# Copy to .env next to docker-compose.yml. Never commit .env.
#
# GitHub PAT with Contents: Read on MartianBerk/baked-auth-client
# (required for docker compose build of auth / user / superiorsix / app image).
BAKED_AUTH_CLIENT_GIT_TOKEN=

# Production — set a long random HS256 secret (shared across all three APIs).
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_KEY_ID=
JWT_PREVIOUS_SECRET_KEYS='[]'

USER_JWT_AUDIENCE=superiorsix
SUPERIORSIX_JWT_AUDIENCE=superiorsix

# Bootstrap super user (auth-audience admin). Used once:
#   docker compose exec baked-auth baked-auth-bootstrap
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=
# SUPERIORSIX_AUTH_ADMIN_EMAIL=
# SUPERIORSIX_AUTH_ADMIN_PASSWORD=

# Browser origins — quote as a single JSON string.
CORS_ORIGINS='["https://superiorsix.co.uk","http://127.0.0.1:8040"]'

# Optional match ingest (football-data.org / goal-api).
FOOTBALL_DATA_API_TOKEN=
GOAL_API_KEY=

# Published host port for nginx FE + same-origin API proxy paths (default 8040).
# FE_HOST_PORT=8040

# Optional overrides for baked-superiorsix-app image build (same-origin hybrid).
# EXPO_PUBLIC_AUTH_URL=/auth
# EXPO_PUBLIC_USER_URL=/user
# EXPO_PUBLIC_SUPERSIX_URL=/superiorsix
# EXPO_BASE_URL=/super
