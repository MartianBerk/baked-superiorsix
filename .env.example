SUPERIORSIX_ENVIRONMENT=development
SUPERIORSIX_JWT_SECRET_KEY=replace-with-a-long-random-secret
SUPERIORSIX_JWT_ALGORITHM=HS256
SUPERIORSIX_JWT_KEY_ID=
SUPERIORSIX_JWT_PREVIOUS_SECRET_KEYS=[]
SUPERIORSIX_JWT_JWKS_PATH=
# Must match baked-auth application slug / JWT aud
SUPERIORSIX_JWT_AUDIENCE=superiorsix
SUPERIORSIX_DATABASE_URL=sqlite+aiosqlite:///./baked_superiorsix.db
SUPERIORSIX_CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081","http://localhost:19006","http://127.0.0.1:19006","http://localhost:8040","http://127.0.0.1:8040","http://localhost:3000"]
SUPERIORSIX_AUTH_TOKEN_URL=http://127.0.0.1:8010/v1/auth/token
# baked-user — roster / display names keyed by auth sub (SS-13)
# Host poetry often uses :8001; Docker local-dev publishes user on :8020.
SUPERIORSIX_USER_SERVICE_URL=http://127.0.0.1:8020
SUPERIORSIX_USER_APP_NAME=superiorsix
# GitHub PAT (read: MartianBerk/baked-auth-client) for `docker compose build`
# BAKED_AUTH_CLIENT_GIT_TOKEN=
# Full local stack (sibling repos): see baked-devops/local-dev/

# Match / league / tournament / auto-score ingest (set by deployment; never commit real values)
# football-data.org — league catalog (v2), PL/ELC + tournament (FAC/EC/WC) match ingest (v4);
# header X-Auth-Token. Also accepted as SUPERIORSIX_FOOTBALL_DATA_API_TOKEN.
FOOTBALL_DATA_API_TOKEN=
# Goal API — EL1 + EL2 match extract and auto-score live pulls; Authorization: Bearer …
# Also accepted as SUPERIORSIX_GOAL_API_KEY.
GOAL_API_KEY=
