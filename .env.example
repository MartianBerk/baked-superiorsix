SUPERIORSIX_ENVIRONMENT=development
SUPERIORSIX_JWT_SECRET_KEY=replace-with-a-long-random-secret
SUPERIORSIX_JWT_ALGORITHM=HS256
SUPERIORSIX_JWT_KEY_ID=
SUPERIORSIX_JWT_PREVIOUS_SECRET_KEYS=[]
SUPERIORSIX_JWT_JWKS_PATH=
# Must match baked-auth application slug / JWT aud
SUPERIORSIX_JWT_AUDIENCE=superiorsix
SUPERIORSIX_DATABASE_URL=sqlite+aiosqlite:///./baked_superiorsix.db
SUPERIORSIX_CORS_ORIGINS=["http://localhost:3000"]
SUPERIORSIX_AUTH_TOKEN_URL=http://127.0.0.1:8010/v1/auth/token
# baked-user — roster / display names keyed by auth sub (SS-13)
SUPERIORSIX_USER_SERVICE_URL=http://127.0.0.1:8001
SUPERIORSIX_USER_APP_NAME=superiorsix
# GitHub PAT (read: MartianBerk/baked-auth-client) for `docker compose build`
# BAKED_AUTH_CLIENT_GIT_TOKEN=

# Match / league ingest (set by deployment; never commit real values)
# football-data.org — league catalog (v2) + PL/ELC match ingest (v4); header X-Auth-Token
FOOTBALL_DATA_API_TOKEN=
# Goal API — EL1 + EL2 match extract; Authorization: Bearer …
GOAL_API_KEY=
